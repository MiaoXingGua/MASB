{
	// 检查“连接游戏服务器失败/登录信息拉取失败”，点击“重试”后返回主流程
	"CheckRetry": {
		"focus": "连接游戏服务器失败/登录信息拉取失败",
		"recognition": {
			"type": "OCR",
			"param": {"expected": ["连接游戏服务器", "信息拉取"], "roi": [0, 0, 0, 0], "replace": ["购", "败"]}
		},
		"next": ["_CheckRetry"]
	},
	"_CheckRetry": {
		"recognition": {"type": "OCR", "param": {"expected": "重试", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"post_delay": 2000 // 点击后延迟2s，等待网络响应
	},

	"CheckRelogin": {
		"focus": "无法连接服务器",
		"recognition": {"type": "OCR", "param": {"expected": "无法连接服务器", "roi": [0, 0, 0, 0]}},
		"next": ["_CheckRelogin"]
	},
	"_CheckRelogin": {
		"recognition": {"type": "OCR", "param": {"expected": "重新登录", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"post_delay": 2000 // 点击后延迟2s，等待网络响应
	}
}
