{
	"CloseAd": {
		"focus": "> 关闭广告",
		"recognition": {
			"type": "TemplateMatch", // 用图像匹配（X按钮更稳定）
			"param": {
				"template": ["ad_close.png", "ad_close_red.png"], // 需准备720p裁剪图像
				"threshold": 0.6, // 匹配得分（1就是100%匹配）
				"roi": [0, 0, 0, 0] // 实际点击区域 但是不同流程位置可能不同 直接取全屏范围
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "_CloseAd_End"],
		"post_delay": 500 // 点击后延迟0.5s
	},
	"_CloseAd_End": {},
	"LevelUp": {
		"focus": "> 等级提升",
		"recognition": {"type": "OCR", "param": {"expected": "等级提升", "roi": [570, 390, 140, 65]}}, // [581, 399, 119, 44]
		"action": {"type": "Click", "param": {"target": true}},
		"post_delay": 800
	},
	"UpdatingMaintenance": {
		"focus": "> 系统维护中...",
		"recognition": {"type": "OCR", "param": {"expected": "维护", "roi": [0, 0, 0, 0]}},
		"next": ["_UpdatingMaintenance", "_UpdatingMaintenance_End"],
		"post_delay": 800
	},
	"_UpdatingMaintenance": {
		"recognition": {"type": "OCR", "param": {"expected": "查看公告", "roi": [580, 550, 125, 55]}}, // [588, 561, 104, 33]
		"action": {"type": "Click", "param": {"target": true}},
		"post_delay": 800
	},
	"_UpdatingMaintenance_End": {}
}
