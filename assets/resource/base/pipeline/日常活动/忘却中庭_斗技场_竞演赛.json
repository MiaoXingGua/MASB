{
	"忘却中庭_斗技场_竞演赛_开始": {
		"focus": "> 开始 【竞演赛】",
		"max_hit": 1,
		"next": ["Courtyard_Arena_Gauntlet_EnterYard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "[JumpBack]CloseAd"]
	},

	"Courtyard_Arena_Gauntlet_EnterYard": {
		"focus": "> 进入【忘却中庭】",
		"recognition": {"type": "OCR", "param": {"expected": "忘却中庭", "roi": [1145, 370, 105, 45]}}, // [1157, 382, 83, 25]
		"action": {"type": "Click", "param": {"target": true, "target_offset": [0, -50, 0, 0]}},
		"next": ["Courtyard_Arena_Gauntlet_ClickBloodArena", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Arena_Gauntlet_ClickBloodArena": {
		"focus": "> 点击【鲜血斗技场】",
		"recognition": {"type": "OCR", "param": {"expected": "鲜血斗技场", "roi": [75, 345, 130, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_ClickDeathMatch", "Courtyard_Arena_Gauntlet_HasOver","[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1000
	},

	"Courtyard_Arena_Gauntlet_HasOver": {
		"focus": "> 没开",
		"next": ["Courtyard_Arena_Gauntlet_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},


	"Courtyard_Arena_Gauntlet_ClickDeathMatch": {
		"focus": "> 点击【竞演赛】进入挑战界面",
		"recognition": {"type": "OCR", "param": {"expected": "竞演赛", "roi": [0, 0, 0, 0]}}, // 位置会变更（有特殊斗技场不定时开放） [570, 107, 95, 38] → [560, 95, 115, 60]
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Courtyard_Arena_Gauntlet_ReadyToMatchOpponent",
			"Courtyard_Arena_Gauntlet_Closed",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 1000
	},

	"Courtyard_Arena_Gauntlet_Closed": {
		"focus": "> 新赛季准备中",
		"recognition": {"type": "OCR", "param": {"expected": "新赛季准备中", "roi": [555, 100, 170, 55]}}, // [566, 111, 147, 33]
		"next": ["Courtyard_Arena_Gauntlet_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Arena_Gauntlet_ReadyToMatchOpponent": {
		"focus": "> 准备选择对手",
		"recognition": {"type": "OCR", "param": {"expected": "今日可购买次数", "roi": [495, 15, 220, 45]}},
		"next": ["Courtyard_Arena_Gauntlet_HasFreeChance", "Courtyard_Arena_Gauntlet_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	// 有免费挑战机会
	"Courtyard_Arena_Gauntlet_HasFreeChance": {
		"focus": "> 准备选择对手",
		"recognition": {"type": "OCR", "param": {"expected": "免费挑战", "roi": [565, 145, 80, 45]}},
		"next": ["Courtyard_Arena_Gauntlet_CheckBranches", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	// 开始筛选对手
	"Courtyard_Arena_Gauntlet_CheckBranches": {
		"focus": "> 检查3个挑战位+刷新按钮（任意一个可点就行）",
		"next": [
			"Courtyard_Arena_Gauntlet_Branch1",
			"Courtyard_Arena_Gauntlet_Branch2",
			"Courtyard_Arena_Gauntlet_Branch3",
			"Courtyard_Arena_Gauntlet_Refresh",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		]
	},
	// 40w ^((0)|([1-9]\\d{0,4})|([1-3]\\d{5}))$
	// 42w ^(0|[1-9]\\d{0,4}|[0-3]\\d{5}|4[0-1]\\d{4})$
	// 14w ^(0|[1-9]\d{0,4}|1[0-3]\d{4})$
	"Courtyard_Arena_Gauntlet_Branch1": {
		"focus": ">  ①战斗力 < 14w",
		"recognition": {"type": "OCR", "param": {"expected": "^(0|[1-9]\\d{0,4}|1[0-3]\\d{4})$", "roi": [590, 410, 70, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_EnterBattle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	"Courtyard_Arena_Gauntlet_Branch2": {
		"focus": "> ②战斗力 < 14w",
		"recognition": {"type": "OCR", "param": {"expected": "^(0|[1-9]\\d{0,4}|1[0-3]\\d{4})$", "roi": [855, 410, 70, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_EnterBattle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	"Courtyard_Arena_Gauntlet_Branch3": {
		"focus": "> ③战斗力 < 14w",
		"recognition": {"type": "OCR", "param": {"expected": "^(0|[1-9]\\d{0,4}|1[0-3]\\d{4})$", "roi": [1130, 410, 70, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_EnterBattle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	"Courtyard_Arena_Gauntlet_Refresh": {
		"focus": "> 三个都 ≥ 14万，点刷新",
		"recognition": {"type": "TemplateMatch", "param": {"template": "courtyard_arena_crucible_refresh.png", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_CheckBranches", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"], // 刷新完再重新检查
		"post_delay": 1500
	},

	"Courtyard_Arena_Gauntlet_EnterBattle": {
		"focus": "> 进入战斗",
		"recognition": {"type": "OCR", "param": {"expected": "进入战斗", "roi": [590, 490, 120, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_Battle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 3000
	},

	"Courtyard_Arena_Gauntlet_Battle": {
		"next": [
			"Courtyard_Arena_Gauntlet_QuickBattle",
			"Courtyard_Arena_Gauntlet_ReadyToMatchOpponent",
			"Courtyard_Arena_Gauntlet_TapTap",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		]
	},

	"Courtyard_Arena_Gauntlet_QuickBattle": {
		"focus": "> 点击【快速战斗】",
		"recognition": {"type": "OCR", "param": {"expected": "快速战斗", "roi": [1140, 490, 120, 55]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Gauntlet_Battle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1000
	},

	"Courtyard_Arena_Gauntlet_TapTap": {
		"focus": "> 随便点点",
		"action": {"type": "Click", "param": {"target": [640, 650, 0, 0]}},
		"next": ["Courtyard_Arena_Gauntlet_Battle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1200
