{
	// 入口：贵宾商店任务
	"贵宾商店_开始": {
		"focus": "> 开始 【贵宾商店】",
		"next": ["VIPShop_EnterVIPShop"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	// 点击【贵宾商店】
	"VIPShop_EnterVIPShop": {
		"focus": "> 点击【贵宾商店】",
		"recognition": {"type": "OCR", "param": {"expected": "贵宾商店", "roi": [130, 170, 105, 55]}}, // [144, 189, 81, 34]
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["VIPShop_ClickDailyGift"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500
	},

	// 点击【日常好礼】
	"VIPShop_ClickDailyGift": {
		"focus": "> 点击【日常好礼】",
		"recognition": {"type": "OCR", "param": {"expected": "日常好礼", "roi": [70, 165, 105, 50]}}, // [82, 177, 86, 29]
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["VIPShop_ClickMonthlyRecommend"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 点击【每月推荐】
	"VIPShop_ClickMonthlyRecommend": {
		"focus": "> 点击【每月推荐】",
