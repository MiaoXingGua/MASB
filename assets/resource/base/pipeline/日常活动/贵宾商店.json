		"next": ["VIPShop_EnterVIPShop", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	// 点击【贵宾商店】
	"VIPShop_EnterVIPShop": {
		"focus": "> 点击【贵宾商店】",
