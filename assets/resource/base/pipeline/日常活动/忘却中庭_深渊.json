	"Courtyard_Abyss_NextBattle": {
		"focus": "> 点击返回",
		"recognition": {"type": "TemplateMatch", "param": {"template": "return_button.png", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Courtyard_Abyss_DailyChances", // 进入战斗
			"Courtyard_Abyss_End" // 结束
		],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 3000
	},

	"Courtyard_Abyss_EnterBattle": {
		"focus": "> 点击【开始战斗】",
		"recognition": {"type": "OCR", "param": {"expected": "开始战斗", "roi": [945, 610, 120, 55]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Fight"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 完成部署 开战
	"Courtyard_Abyss_Fight": {
		"focus": "> 开战",
		"recognition": {"type": "OCR", "param": {"expected": "完成", "roi": [1155, 600, 75, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_NextFight", "Courtyard_Abyss_Click", "Courtyard_Abyss_NextBattle"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 下一层 战斗
	"Courtyard_Abyss_NextFight": {
		"focus": "> 开战",
		"recognition": {"type": "OCR", "param": {"expected": "下一层", "roi": [1080, 615, 140, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Fight", "Courtyard_Abyss_Click", "Courtyard_Abyss_NextBattle"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Abyss_Click": {
		"focus": "> 点击",
		"action": {"type": "Click", "param": {"target": [1160, 605, 50, 30]}},
		"next": ["Courtyard_Abyss_Fight", "Courtyard_Abyss_NextFight", "Courtyard_Abyss_NextBattle"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800,
		"timeout": 300000 // 5分钟
	},

	"Courtyard_Abyss_End": {
		"focus": "> 【通天深渊】 结束",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
