	//     "recognition": {
	//         "type": "TemplateMatch",
	//         "param": {
	//             "template": ["abyss_next.png"],
	//             // "threshold": 0.7, // 因为有背景原色 只能到0.75左右
	//             "roi": [545, 585, 145, 50]
	//         }
	//     },
	//     "action": { "type": "Click", "param": { "target": true } },
	//     "next": [
	//         "Courtyard_Abyss_EnterBattle", // 进入战斗
	//         // "Courtyard_Abyss_NextBattle", // 再翻一页（最多4页）
	//         "Courtyard_Abyss_End" // 结束
	//     ],
	//     "post_delay": 1500
	// },

	"Courtyard_Abyss_NextBattle": {
		"focus": "> 点击返回",
		"recognition": {
			"type": "TemplateMatch", // 用图像匹配（X按钮更稳定）
			"param": {
				"template": "return_button.png"
				// "threshold": 0.7, // 匹配得分（1就是100%匹配）
				// "roi": [20, 15, 85, 45]
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Courtyard_Abyss_DailyChances", // 进入战斗
			"Courtyard_Abyss_End" // 结束
		],
		"post_delay": 3000
	},

	"Courtyard_Abyss_EnterBattle": {
		"focus": "> 点击【开始战斗】",
		"recognition": {"type": "OCR", "param": {"expected": "开始战斗", "roi": [950, 615, 110, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Fight"],
		"post_delay": 800
	},

	// 完成部署 开战
	"Courtyard_Abyss_Fight": {
		"focus": "> 开战",
		"recognition": {"type": "OCR", "param": {"expected": "完成", "roi": [1160, 605, 65, 40]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_NextFight", "Courtyard_Abyss_Click", "Courtyard_Abyss_NextBattle"],
		"post_delay": 800
	},

	// 下一层 战斗
	"Courtyard_Abyss_NextFight": {
		"focus": "> 开战",
		"recognition": {"type": "OCR", "param": {"expected": "下一层", "roi": [1085, 620, 130, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Fight", "Courtyard_Abyss_Click", "Courtyard_Abyss_NextBattle"],
		"post_delay": 800
	},

	"Courtyard_Abyss_Click": {
		"focus": "> 点击",
		"action": {"type": "Click", "param": {"target": [1160, 605, 50, 30]}},
		"next": ["Courtyard_Abyss_Fight", "Courtyard_Abyss_NextFight", "Courtyard_Abyss_NextBattle"],
		"post_delay": 800,
		"timeout": 300000 // 5分钟
	},

	"Courtyard_Abyss_End": {
		"focus": "> 通天深渊 结束",
		"next": ["Return_Home"]
	}
}
