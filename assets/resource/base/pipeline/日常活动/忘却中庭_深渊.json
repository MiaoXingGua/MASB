{
	"忘却中庭_通天深渊_开始": {
		"focus": "> 开始 忘却中庭 通天深渊",
		"next": ["Courtyard_Abyss_Counter"]
	},

	// 初始化计数器
	"Courtyard_Abyss_Counter": {
		"action": "Custom",
		"custom_action": "init_counter",
		"custom_action_param": "key=courtyard_abyss_counter&max=5&exceed=true",
		"next": ["Courtyard_Abyss_EnterYard"]
	},

	"Courtyard_Abyss_EnterYard": {
		"focus": "> 进入【忘却中庭】",
		"recognition": {"type": "OCR", "param": {"expected": "忘却中庭", "roi": [1150, 393, 100, 35]}},
		"action": {"type": "Click", "param": {"target": true, "target_offset": [0, -50, 0, 0]}},
		"next": [
			"Courtyard_Abyss_EnterAbyss",
			"Courtyard_Abyss_EnterYard" // BUG：有时click可能一次点不中
		],
		"post_delay": 800
	},

	"Courtyard_Abyss_EnterAbyss": {
		"focus": "> 进入【通天深渊】",
		"recognition": {"type": "OCR", "param": {"expected": "通天深渊", "roi": [240, 170, 95, 25]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Counter_Increase"],
		"post_delay": 800
	},

	// 开始计数
	"Courtyard_Abyss_Counter_Increase": {
		"action": "Custom",
		"custom_action": "count",
		"custom_action_param": "key=courtyard_abyss_counter&t=深渊",
		"next": ["Courtyard_Abyss_DailyChances", "Courtyard_Abyss_Counter_Increase"],
		"on_error": ["Courtyard_Abyss_End"]
	},

	"Courtyard_Abyss_DailyChances": {
		"focus": "> 点击【每日通关】",
		"recognition": {"type": "OCR", "param": {"expected": "^每日通关[1-3]$"}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Battle"],
		"post_delay": 800
	},

	"Courtyard_Abyss_Battle": {
		"focus": "> 循环",
		"next": [
			"Courtyard_Abyss_EnterBattle", // 开始战斗
			"Courtyard_Abyss_NextBattle" // next
		],
		"post_delay": 1500
	},

	// "Courtyard_Abyss_NextBattle": {
