{
	"忘却中庭_通天深渊_开始": {
		"focus": "> 开始 【通天深渊】",
		"next": ["Courtyard_Abyss_Counter", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "[JumpBack]CloseAd"]
	},

	// 初始化计数器
	"Courtyard_Abyss_Counter": {
		"action": "Custom",
		"custom_action": "init_counter",
		"custom_action_param": "key=courtyard_abyss_counter&max=5&exceed=true",
		"next": ["Courtyard_Abyss_EnterYard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	"Courtyard_Abyss_EnterYard": {
		"focus": "> 进入【忘却中庭】",
		"recognition": {"type": "OCR", "param": {"expected": "忘却中庭", "roi": [1145, 388, 110, 45], "only_rec": true}},
		"action": {"type": "Click", "param": {"target": true, "target_offset": [0, -50, 0, 0]}},
		"next": ["Courtyard_Abyss_EnterAbyss", "Courtyard_Abyss_EnterYard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Abyss_EnterAbyss": {
		"focus": "> 进入【通天深渊】",
		"recognition": {"type": "OCR", "param": {"expected": "通天深渊", "roi": [235, 165, 105, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Counter_Increase", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	// 开始计数
	"Courtyard_Abyss_Counter_Increase": {
		"action": "Custom",
		"custom_action": "count",
		"custom_action_param": "key=courtyard_abyss_counter&t=深渊",
		"next": ["Courtyard_Abyss_DailyChances", "Courtyard_Abyss_Counter_Increase", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"on_error": ["Courtyard_Abyss_End"]
	},

	"Courtyard_Abyss_DailyChances": {
		"focus": "> 点击【每日通关】",
		"recognition": {"type": "OCR", "param": {"expected": "^每日通关[1-3]", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Abyss_Battle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Abyss_Battle": {
		"focus": "> 循环",
		"next": ["Courtyard_Abyss_EnterBattle", "Courtyard_Abyss_NextBattle", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1500
	},

