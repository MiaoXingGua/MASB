{
	"好友_通过_开始": {
		"focus": "> 开始 【通过好友】",
		"next": ["Friend_Accept_Enter"],
		"interrupt": ["CheckRetry", "CheckRelogin", "CloseAd"]
	},

	"Friend_Accept_Enter": {
		"focus": "> 进入【好友界面】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": ["friend_main.png", "friend_main_new.png"], "threshold": 0.8, "roi": [0, 0, 0, 0]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Accept_ClickNewFriend", "Friend_Accept_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500
	},

	"Friend_Accept_ClickNewFriend": {
		"focus": "> 进入【新好友界面】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": "friend_new.png", "threshold": 0.8, "roi": [0, 0, 0, 0]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Accept_AllPass", "Friend_Accept_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1000
	},

	"Friend_Accept_AllPass": {
		"focus": "> 【全部通过】",
		"recognition": {"type": "OCR", "param": {"expected": "全部通过", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Accept_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Friend_Accept_End": {
		"focus": "> 【通过好友】 结束",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
