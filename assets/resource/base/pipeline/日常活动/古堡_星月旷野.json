{
	// 入口：古堡_星月旷野任务
	"古堡_星月旷野_开始": {
		"focus": "> 开始 【古堡_星月旷野】",
		"next": [
			"Castle_Wilderness_EnterCastle",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin",
			"[JumpBack]CloseAd"
		]
	},

	// 点击【古堡】
	"Castle_Wilderness_EnterCastle": {
		"focus": "> 点击【古堡】",
		"recognition": {"type": "OCR", "param": {"expected": "古堡", "roi": [550, 670, 60, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_EnterWilderness",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 1500,
		"rate_limit": 3000,
		"timeout": 60000
	},

	// 点击【星月旷野】
	"Castle_Wilderness_EnterWilderness": {
		"focus": "> 点击【星月旷野】",
		"recognition": {"type": "OCR", "param": {"expected": "星月旷野", "roi": [420, 369, 105, 60]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickCloseList",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 1500,
		"rate_limit": 3000,
		"timeout": 60000
	},

	// 点击【wilderness_event_list_close.png】
	"Castle_Wilderness_ClickCloseList": {
		"focus": "> 展开【事件列表】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": "wilderness_event_list_close.png", "threshold": 0.8, "roi": [1170, 15, 55, 50]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_CheckOpenList",
			"Castle_Wilderness_CheckNoEvent",
			"Castle_Wilderness_ClickCloseList",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 识别【没有可进行的旷野事件】（无事件时直接结束）
	"Castle_Wilderness_CheckNoEvent": {
		"focus": "> 没有可进行的旷野事件",
		"recognition": {"type": "OCR", "param": {"expected": "没有可进行", "roi": [505, 95, 280, 65]}}, // [520, 108, 238, 36]
		"next": [
			"Castle_Wilderness_End",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 确认事件列表已展开
	"Castle_Wilderness_CheckOpenList": {
		"focus": "> 确认【事件列表】已展开",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": "wilderness_event_list_open.png", "threshold": 0.8, "roi": [1170, 15, 55, 50]}
		},
		"next": [
			"Castle_Wilderness_ClickEvent",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击【wilderness_event.png】
	"Castle_Wilderness_ClickEvent": {
		"focus": "> 点击【旷野事件】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": "wilderness_event.png", "threshold": 0.8, "roi": [1155, 125, 75, 85]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickConfirm",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击【确认】
	"Castle_Wilderness_ClickConfirm": {
		"focus": "> 点击【确认】触发事件",
		"recognition": {"type": "OCR", "param": {"expected": "确认", "roi": [775, 520, 75, 60]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickContinue1",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击任意处继续
	"Castle_Wilderness_ClickContinue1": {
		"focus": "> 点击任意处继续",
		"recognition": {"type": "OCR", "param": {"expected": "点击任意处继续", "roi": [555, 635, 165, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickSkip",
			"Castle_Wilderness_ClickContinue1",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击【wilderness_event_skip.png】
	"Castle_Wilderness_ClickSkip": {
		"focus": "> 点击跳过事件",
		"recognition": {"type": "TemplateMatch", "param": {"template": "wilderness_event_skip.png", "threshold": 0.8, "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_CheckSkipConfirm",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 确认跳过确认弹窗
	"Castle_Wilderness_CheckSkipConfirm": {
		"focus": "> 确认跳过弹窗",
		"recognition": {"type": "OCR", "param": {"expected": "是否确认跳过", "roi": [290, 280, 170, 55]}},
		"next": [
			"Castle_Wilderness_ClickSkipConfirm",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击【确认】（跳过确认）
	"Castle_Wilderness_ClickSkipConfirm": {
		"focus": "> 点击【确认】跳过事件",
		"recognition": {"type": "OCR", "param": {"expected": "确认", "roi": [775, 460, 90, 65]}}, // [790, 473, 60, 40]
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickContinue2",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 点击任意处继续 2
	"Castle_Wilderness_ClickContinue2": {
		"focus": "> 点击任意处继续",
		"recognition": {"type": "OCR", "param": {"expected": "点击任意处继续", "roi": [555, 635, 165, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Castle_Wilderness_ClickCloseList",
			"Castle_Wilderness_EnterWilderness",
			"Castle_Wilderness_ClickContinue2",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800,
		"rate_limit": 2000,
		"timeout": 15000
	},

	// 任务结束
	"Castle_Wilderness_End": {
		"focus": "> 【古堡_星月旷野】 结束",
		"next": [
			"Return_Home",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		]
	}
}
