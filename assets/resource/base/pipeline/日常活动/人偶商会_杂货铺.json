/*
  循环入口
  ├─1─ 免费(左) → 购买 → 继续 → 回循环
  ├─2─ 免费(右) → 刷新 → 确认 → 回循环
  └─3─ 结束
**/

{
    // 入口：杂货铺主任务
    "人偶商店_杂货铺_开始": {
        "focus": "> 启动人偶商店 - 杂货铺",
        "next": ["Puppet_CheckMerchant"]
    },

    // 首页：点击「人偶商会」进入
    "Puppet_CheckMerchant": {
        "focus": "> 点击人偶商会进入界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "人偶商会",
                "roi": [30, 185, 100, 45]  // 精准ROI，避免误触其他文字
            }
        },
        "action": {
            "type": "Click",
            "param": { "target": true }
        },
        "next": ["Puppet_MainLoop"],
        "post_delay": 1500,
        "rate_limit": 2000
    },

    // 【主循环入口】依次尝试 1→2→3→4
    "Puppet_MainLoop": {
        "focus": "> 循环入口：尝试路径1→2→3...",
        "next": [
            "Puppet_CheckFree",   // 路径1 购买免费物品
            "Puppet_CheckFreeRefresh",  // 路径2
            "Puppet_EndTask"                // 路径3：结束
        ],
        "rate_limit": 2000,
        "timeout": 60000
    },

    // ————————————————————————
    // 【路径1】左屏免费 → 购买 → 继续 → 回循环
    // ————————————————————————
    "Puppet_CheckFree": {
        "focus": "> 检查是否有「免费」物品...",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "免费",
                // "roi": [50, 200, 600, 800]  // 左半屏
                "roi": [320, 395, 60, 40]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Puppet_BuyFree"],
        "post_delay": 800
    },

    // 【路径1-1】点击《购买》
    "Puppet_BuyFree": {
        "focus": "> 点击「购买」按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "购买",
                "roi": [895, 535, 75, 45]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Puppet_ClickContinue"],
        "post_delay": 800
    },

    // 【路径1-2】点击任意处继续【最后回到循环】
    "Puppet_ClickContinue": {
        "focus": "> 点击任意处继续（点文字）...",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "点击任意处继续",
                "roi": [560, 640, 155, 35]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Puppet_MainLoop"],  // **回到循环！**
        "post_delay": 800
    },

    // ————————————————————————
    // 【路径2】右屏免费 → 刷新 → 确认 → 回循环
    // ————————————————————————
    "Puppet_CheckFreeRefresh": {
        "focus": "> 检查是否有「免费」刷新...",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "免费",
                // "roi": [680, 0, 600, 800]  // 右半屏
                "roi": [820, 45, 45, 35]
            }
        },
        "next": ["Puppet_ClickRefreshBtn"],
        "post_delay": 800
    },

    // 【路径2-1】点击刷新按钮（图片）
    "Puppet_ClickRefreshBtn": {
        "focus": "> 点击刷新按钮...",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "button_refresh_commodities.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Puppet_ClickConfirm"],
        "post_delay": 1000
    },

    // 【路径2-2】点击《确认》【最后回到循环】
    "Puppet_ClickConfirm": {
        "focus": "> 点击确认...",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确认",
                "roi": [790, 475, 60, 40]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Puppet_MainLoop"], // **回到循环！**
        "post_delay": 800
    },


    // ————————————————————————
    // 【路径3】结束任务
    // ————————————————————————
    "Puppet_EndTask": {
        "focus": "> 人偶商会_杂货铺 任务结束...",
        "next": ["Puppet_Return_To_Main"]
    },

    "Puppet_Return_To_Main": {
        "focus": "> 点击返回",
        "recognition": {
            "type": "OCR",
            "param": { "expected": "返回" }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "next": ["人偶商店_杂货铺_结束"],
        "post_delay": 1000
    },

    "人偶商店_杂货铺_结束": {
        "focus": "> 人偶商会_杂货铺 任务完成！"
    }
}
