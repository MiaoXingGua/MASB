{
	"好友_申请_开始": {
		"focus": "> 开始 申请 好友 ",
		"next": ["Friend_Apply_Counter"]
	},

	// 初始化计数器
	"Friend_Apply_Counter": {
		"action": "Custom",
		"custom_action": "init_counter",
		"custom_action_param": "key=friend_apply_counter&max=3&exceed=true",
		"next": ["Friend_Apply_Enter"]
	},

	"Friend_Apply_Enter": {
		"focus": "> 点击主界面好友按钮",
		"recognition": {
			"type": "TemplateMatch",
			"param": {
				"template": ["friend_main.png", "friend_main_new.png"],
				"threshold": 0.8
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_FriendList", "Friend_Apply_End"],
		"post_delay": 800
	},

	"Friend_Apply_FriendList": {
		"focus": "> 点开添加好友页面",
		"recognition": {
			"type": "TemplateMatch",
			"param": {
				"template": "friend_apply.png",
				"threshold": 0.8,
				"roi": [25, 260, 60, 80]
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_Counter_increase", "Friend_Apply_End"],
		"post_delay": 800
	},

	// 开始计数
	"Friend_Apply_Counter_increase": {
		"action": "Custom",
		"custom_action": "count",
		"custom_action_param": "key=friend_apply_counter&t=申请好友",
		"next": ["Friend_Apply_All"],
		"on_error": ["Friend_Apply_End"]
	},

	// 申请好友
	"Friend_Apply_All": {
		"focus": "全部申请～",
		"recognition": {
			"type": "OCR",
			"param": {"expected": "全部申请"}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_Full", "Friend_Apply_Refresh"],
		"post_delay": 500
	},

	// 好友已满
	"Friend_Apply_Full": {
		"focus": "> 好友已满～",
		"recognition": {"type": "OCR", "param": {"expected": "好友已满"}},
		"next": ["Friend_Apply_End"]
		// "post_delay": 200
	},

	// 刷新 friend_Apply_refresh.png
	"Friend_Apply_Refresh": {
		"focus": "> 刷新",
		"recognition": {
			"type": "TemplateMatch",
			"param": {
				"template": "friend_apply_refresh.png",
				"threshold": 0.8,
				"roi": [1180, 65, 75, 35]
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_Counter_increase", "Friend_Apply_End"],
		"post_delay": 3000 // 3s
	},

	// 停止刷新

	"Friend_Apply_End": {
		"focus": "> 好友 申请 结束",
		"next": ["Return_Home"]
	}
}
