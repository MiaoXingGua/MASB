{
	"好友_申请_开始": {
		"focus": "> 开始 【申请好友】",
		"max_hit": 1,
		"next": ["Friend_Apply_Enter", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "[JumpBack]CloseAd"]
	},

	"Friend_Apply_Enter": {
		"focus": "> 进入【好友界面】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {
				"template": ["friend_main.png", "friend_main_new.png", "friend_main_black.png", "friend_main_new_black.png"],
				"threshold": 0.8,
				"roi": [465, 0, 70, 70]
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_FriendList", "Friend_Apply_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Friend_Apply_FriendList": {
		"focus": "> 进入【添加好友界面】",
		"recognition": {"type": "TemplateMatch", "param": {"template": "friend_apply.png", "threshold": 0.8, "roi": [20, 255, 70, 90]}}, // [27, 264, 50, 70]
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_All", "Friend_Apply_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	// 申请好友
	"Friend_Apply_All": {
		"focus": "> 【全部申请】",
		"recognition": {"type": "OCR", "param": {"expected": "全部申请", "roi": [1050, 635, 125, 55]}}, // [1060, 645, 105, 33]
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Friend_Apply_Full", // 好友已满
			"Friend_Apply_Refresh", // 刷新 最多3次
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin",
			"Friend_Apply_End" // 结束
		],
		"post_delay": 500
	},

	// 好友已满
	"Friend_Apply_Full": {
		"focus": "> 好友已满",
		"next": ["Friend_Apply_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	// 刷新 friend_Apply_refresh.png
	"Friend_Apply_Refresh": {
		"focus": "> 【刷新】",
		"max_hit": 3, // 最多刷新3次
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": "friend_apply_refresh.png", "threshold": 0.8, "roi": [1175, 60, 85, 45]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Apply_Enter", "Friend_Apply_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 3000 // 3s
	},

	// 停止刷新
	"Friend_Apply_End": {
		"focus": "> 【申请好友】 结束",
		"next": ["Return_Home", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	}
}
