{
    // 入口：鲜血商店主任务
    "人偶商店_鲜血商店_开始": {
        "focus": "> 启动人偶商店 - 鲜血商店",
        "next": ["Blood_CheckMerchant"]
    },

    // 首页：点击「人偶商会」进入
    "Blood_CheckMerchant": {
        "focus": "> 点击人偶商会进入界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "人偶商会",
                "roi": [30, 185, 100, 45]
            }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "next": ["Blood_WaitForBloodStore"],
        "post_delay": 1500,
        "rate_limit": 2000
    },

    // 等待识别到「血池商店」图标
    "Blood_WaitForBloodStore": {
        "focus": "> 等待血池商店图标出现",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "store_blood.png",
                "threshold": 0.8,
                "roi": [0, 0, 150, 720]
            }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "next": ["Blood_EnterCrystalLoop"],  // 进入晶球循环
        "post_delay": 1500,
        "rate_limit": 2000
    },

    // ————————————————————————
    // 晶球独立循环：1→购买→继续→循环
    // ————————————————————————
    "Blood_EnterCrystalLoop": {
        "focus": "> 进入血池晶球独立循环",
        "next": [
            "Blood_CheckCrystal",     // 路径1：检查晶球
            // "Blood_CheckCommonCrystal",
            "Blood_EndTask"           // 路径2：无晶球 → 结束
        ],
        "rate_limit": 2000,
        "timeout": 60000
    },

    "Blood_CheckCrystal": {
        "focus": "> 检查是否有「晶球」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "晶球" ,
                "replace":["品球","晶球"]
            }
        },
        "next": ["Blood_ClickPurchase"],
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 1500,
        "rate_limit": 2000
    },

    // "Blood_CheckCommonCrystal": {
    //     "focus": "> 检查是否有 通用「晶球」",
    //     "recognition": {
    //         "type": "OCR",
    //         "param": { "expected": "受默示者" },
    //         "roi": [740, 510, 175, 30]
    //     },
    //     "next": ["Blood_ClickPurchase"],
    //     "action": { "type": "Click", "param": { "target": true } },
    //     "post_delay": 1500,
    //     "rate_limit": 2000
    // },

    "Blood_ClickPurchase": {
        "focus": "> 点击「购买」晶球",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "购买",
                "roi": [900, 535, 65, 40]
            }
        },
        "action": {
            "type": "Click", "param": { "target": true } },
        "next": [
            "Blood_ClickContinue",
            "Blood_OutOfResources"
        ],
        "post_delay": 800
    },

    "Blood_ClickContinue": {
        "focus": "> 点击「点击任意处继续」",
        "recognition": {
            "type": "OCR",
            "param": { "expected": "点击任意处继续" }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "next": ["Blood_EnterCrystalLoop"],  // 回到晶球循环
        "post_delay": 800
    },

    "Blood_OutOfResources": {
        "focus": "> 资源不足",
        "recognition": {
            "type": "OCR",
            "param": { "expected": "资源不足" },
            "roi": [590, 105, 100, 45]
        },
        "next": ["Blood_EndTask" ],  // 回到晶球循环
        "post_delay": 800
    },

    // ————————————————————————
    // 路径2：结束任务（通用返回节点）
    // ————————————————————————
    "Blood_EndTask": {
        "focus": "> 人偶商店_鲜血商店 任务结束...",
        "next": [
            "Blood_CheckBack", // 点击《返回》
            "Blood_CheckReturn", // 点击《←》
            "Blood_CheckClose", // 点击《X》
            "人偶商店_鲜血商店_结束"
        ]
    },

    "Blood_CheckReturn": {
        "recognition": {
            "type": "TemplateMatch",  // 用图像匹配（X按钮更稳定）
            "param": {
                "template": "return_button.png",  // 需准备720p裁剪图像
                "threshold": 0.7, // 匹配得分（1就是100%匹配）
                "roi": [0, 0, 0, 0]  // 右上角区域（示例）
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Blood_EndTask"],
        "post_delay": 500    // 点击后延迟0.5s
    },

    // 检查“X”关闭按钮，点击后返回主流程
    "Blood_CheckClose": {
        "recognition": {
            "type": "TemplateMatch",  // 用图像匹配（X按钮更稳定）
            "param": {
                "template": "close_button.png",  // 需准备720p裁剪图像
                "threshold": 0.7, // 匹配得分（1就是100%匹配）
                "roi": [1050, 135, 55, 45] // 右上角区域（示例）
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": ["Blood_EndTask"],
        "post_delay": 500    // 点击后延迟0.5s
    },

    "Blood_CheckBack": {
        "focus": "> 点击返回",
        "recognition": {
            "type": "OCR",
            "param": { "expected": "返回" },
            "roi": [125, 25, 55, 30]
        },
        "action": { "type": "Click", "param": { "target": true } },
        "next": ["Blood_EndTask"],
        "post_delay": 500
    },

    "人偶商店_鲜血商店_结束": {
        "focus": "> 鲜血商店任务完成！"
    }
}
