{
	// 入口：鲜血商店主任务
	"人偶商店_鲜血商店_开始": {
		"focus": "> 开始【商店：鲜血商店】",
		"next": ["Blood_CheckMerchant"],
		"interrupt": ["CheckRetry", "CheckRelogin", "CloseAd"]
	},

	// 首页：点击「人偶商会」进入
	"Blood_CheckMerchant": {
		"focus": "> 进入【人偶商会】",
		"recognition": {"type": "OCR", "param": {"expected": "人偶商会", "roi": [25, 180, 110, 55]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Blood_WaitForBloodStore"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500,
		"rate_limit": 2000
	},

	// 等待识别到「血池商店」图标
	"Blood_WaitForBloodStore": {
		"focus": "> 进入【鲜血商店】",
		"recognition": {"type": "TemplateMatch", "param": {"template": "store_blood.png", "threshold": 0.8, "roi": [0, 0, 160, 730]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Blood_EnterCrystalLoop"], // 进入晶球循环
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500,
		"rate_limit": 2000
	},

	// ————————————————————————
	// 晶球独立循环：1→购买→继续→循环
	// ————————————————————————
	"Blood_EnterCrystalLoop": {
		// "focus": "> 进入血池晶球独立循环",
		"next": [
			"Blood_CheckCrystal", // 路径1：检查晶球
			// "Blood_CheckCommonCrystal",
			"Blood_End" // 路径2：无晶球 → 结束
		],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"rate_limit": 2000,
		"timeout": 60000
	},

	"Blood_CheckCrystal": {
		"focus": "> 检查是否有【晶球】",
		"recognition": {"type": "OCR", "param": {"expected": "晶球", "replace": ["品球", "晶球"], "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Blood_ClickPurchase"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500,
		"rate_limit": 2000
	},

	// "Blood_CheckCommonCrystal": {
	//     "focus": "> 检查是否有 通用「晶球」",
	//     "recognition": {
	//         "type": "OCR",
	//         "param": { "expected": "受默示者" },
	//         "roi": [740, 510, 175, 30]
	//     },
	//     "next": ["Blood_ClickPurchase"],
	//     "action": { "type": "Click", "param": { "target": true } },
	//     "post_delay": 1500,
	//     "rate_limit": 2000
	// },

	"Blood_ClickPurchase": {
		"focus": "> 购买【晶球】",
		"recognition": {"type": "OCR", "param": {"expected": "购买", "roi": [895, 530, 75, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Blood_ClickContinue", "Blood_OutOfResources"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Blood_ClickContinue": {
		"focus": "> 点击任意处继续",
		"recognition": {"type": "OCR", "param": {"expected": "点击任意处继续", "roi": [555, 635, 165, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Blood_EnterCrystalLoop"], // 回到晶球循环
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Blood_OutOfResources": {
		"focus": "> 资源不足",
		"recognition": {"type": "OCR", "param": {"expected": "资源不足", "roi": [585, 100, 110, 55]}},
		"next": ["Blood_End"], // 回到晶球循环
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// ————————————————————————
	// 路径2：结束任务（通用返回节点）
	// ————————————————————————
	"Blood_End": {
		"focus": "> 【商店：鲜血商店】结束",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
