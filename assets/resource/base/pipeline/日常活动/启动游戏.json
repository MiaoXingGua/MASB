
    /**
        打开游戏功能
        1、启动APP doc提示用户
        2、直到识别 《START》点击游戏进入 每3秒检查一次
        PS: 如果 2 没有识别到《START》进入interrupt（异常事件）（异常事件写在1中）
        2_1、如果识别到 《连接服务器失败》 则要识别到《重试》并点击
        2_2、如果识别到 《下载》则点击
        2_3、如果识别到 《开始下载》则点击
        规则：
        ① Node会依次尝试执行next中的Node，直到匹配到能成功执行的Node（如果想让程序必然进入这个Node，则可以设置这个Node什么都不做就是单纯输出一下文字）
        ② 如果①中Node尝试了所有next没有成功的，则开始依次尝试interrupt中Node，如果还没有成功的，则整个pipline结束
        ③ 匹配到next中的Node，进入后会一直顺序执行（不会回头），而匹配到interrupt中的Node，但这个Node的pipline结束则会回到则会回到一开始的interrupt的Node的父Node中


    **/
{
    // 入口：启动《银与血》，空操作跳转StartApp
    "启动游戏_开始": {
        "focus": "> 启动《银与血》",
        "next": ["StartApp"]
    },

    // 启动APP，定义正常流程和异常处理
    "StartApp": {
        "focus": "> 正在启动《银与血》...",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.moonton.silverblood.ap"
            }
        },
        "next": [
            "CheckStart",            // 检查START按钮
            "AlreadyInHomePage"      // 检查是否已在首页
        ],
        "interrupt": [
            "CheckRetry",         // 网络异常.json：点击重试
            "CheckDownload",      // 发现更新.json：点击下载
            "CheckStartDownload", // 开始下载.json：点击开始下载
            "CheckDownloadFinish", // 更新完成 请重启游戏
            "CheckConfirm",        // 确认信息.json：点击确认
            "Login_CheckLoginButton", // 登录游戏.json：点击切换账号
            "CheckProtocol", // 用户协议.json
            "CheckCloseAnnouncement", // 检查公告关闭按钮
            "Tap_ClickAnywhere", // 点击任意处继续
            "CheckReturn",
            "Qianfeng_CheckJourney", // 千峰的旅程活动
        ],
        "post_delay": 5000,   // 启动后延迟5s
        "rate_limit": 5000,   // 每5s检查
        "timeout": 600000     // 总超时10min
    },

    // 检查是否已在首页，成功则结束
    "AlreadyInHomePage": {
        "focus": "> 检查是否在首页...",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "贡礼_血池.png", // 720p裁剪图像
                "threshold": 0.65,
                "roi": [0, 0, 0, 0] // 全屏，建议调试后优化
            }
        },
        "next": ["启动游戏_结束"],
        "timeout": 10000,     // 10s超时，快速检查
        "rate_limit": 2000    // 每2s检查
    },

    // 检查START按钮，成功则点击并检查公告
    "CheckStart": {
        "focus": "> 等待START按钮...",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "START",
                "roi": [537, 529, 185, 107]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "CheckCloseAnnouncement",
            "AlreadyInHomePage"
        ],
        "interrupt": [
            "CheckRetry",         // 网络异常.json：点击重试
            "CheckDownload",      // 发现更新.json：点击下载
            "CheckStartDownload", // 开始下载.json：点击开始下载
            "CheckDownloadFinish", // 更新完成 请重启游戏
            "CheckConfirm",        // 确认信息.json：点击确认
            "Login_CheckLoginButton", // 登录游戏.json：点击切换账号
            "CheckProtocol", // 用户协议.json
            "Tap_ClickAnywhere", // 点击任意处继续
            "CheckReturn",
            "Qianfeng_CheckJourney", // 千峰的旅程活动
        ],
        "pre_delay": 500,     // 识别后延迟0.5s
        "post_delay": 1000,   // 点击后延迟1s
        "rate_limit": 3000,   // 每3s检查
        "timeout": 600000     // 总超时10min
    },

    // 检查公告“X”按钮，15秒内检测到则点击，未检测到结束
    "CheckCloseAnnouncement": {
        "focus": "> 检查公告关闭（X）...",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "close_button.png",
                "threshold": 0.8, // 更严格匹配
                "roi": [1100, 50, 100, 100] // 右上角区域
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "timeout": 15000,       // 15s超时
        "rate_limit": 1000,     // 每1s检查
        "post_delay": 500       // 点击后延迟0.5s
    },

    // 结束：成功进入游戏，终止任务
    "启动游戏_结束": {
        "focus": "> 游戏已成功启动！",
        // "next": []
    }
}
