{
	// 入口：启动《银与血》，空操作跳转StartApp
	"启动游戏_开始": {
		"focus": "> 启动【银与血】",
		"next": ["Start_App"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	// 启动APP，定义正常流程和异常处理
	"Start_App": {
		"focus": "> 正在启动《银与血》...",
		"action": {"type": "StartApp", "param": {"package": "com.moonton.silverblood.ap"}},
		"next": [
			"Start_ClickStart", // 检查START按钮
			"Start_AlreadyInHomePage" // 检查是否已在首页
		],
		"interrupt": [
			"CheckRetry", // 网络异常.json：点击重试
			"CheckDownload", // 发现更新.json：点击下载
			"CheckStartDownload", // 开始下载.json：点击开始下载
			"CheckDownloadFinish", // 更新完成 请重启游戏
			"CheckConfirm", // 确认信息.json：点击确认
			"Login_CheckLoginButton", // 登录游戏.json：点击切换账号
			"CheckProtocol", // 用户协议.json
			"CheckCloseAnnouncement", // 检查公告关闭按钮
			"TapClickAnywhere", // 点击任意处继续
			"CheckReturn",
			// "Qianfeng_CheckJourney", // 千峰的旅程活动
			"TapTap",
			"Return_Home"
		],
		"post_delay": 5000, // 启动后延迟5s
		"rate_limit": 5000, // 每5s检查
		"timeout": 600000 // 总超时10min
	},

	// 检查是否已在首页，成功则结束
	"Start_AlreadyInHomePage": {
		"focus": "> 检查是否在首页...",
		"recognition": {"type": "TemplateMatch", "param": {"template": "blood_pool.png", "threshold": 0.65, "roi": [0, 0, 0, 0]}},
		"next": ["Start_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"timeout": 10000, // 10s超时，快速检查
		"rate_limit": 2000 // 每2s检查
	},

	// 检查START按钮，成功则点击并检查公告
	"Start_ClickStart": {
		"focus": "> 等待START按钮...",
		"recognition": {"type": "OCR", "param": {"expected": "START", "roi": [532, 524, 195, 117]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Start_AlreadyInHomePage"],
		"interrupt": [
			"CheckRetry", // 网络异常.json：点击重试
			"CheckRelogin", // 网络异常.json：重新登录
			"CheckDownload", // 发现更新.json：点击下载
			"CheckStartDownload", // 开始下载.json：点击开始下载
			"CheckDownloadFinish", // 更新完成 请重启游戏
			"CheckConfirm", // 确认信息.json：点击确认
			"Login_CheckLoginButton", // 登录游戏.json：点击切换账号
			"CheckProtocol", // 用户协议.json
			"TapClickAnywhere", // 点击任意处继续
			"CheckReturn",
			"CheckCloseAnnouncement"
		],
		"pre_delay": 500, // 识别后延迟0.5s
		"post_delay": 1000, // 点击后延迟1s
		"rate_limit": 3000, // 每3s检查
		"timeout": 600000 // 总超时10min
	},

	// 检查公告“X”按钮，15秒内检测到则点击，未检测到结束
	"CheckCloseAnnouncement": {
		"focus": "> 检查公告关闭（X）...",
		"recognition": {"type": "TemplateMatch", "param": {"template": "close_button.png", "threshold": 0.8, "roi": [1095, 45, 110, 110]}},
		"action": {"type": "Click", "param": {"target": true}},
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"timeout": 15000, // 15s超时
		"rate_limit": 1000, // 每1s检查
		"post_delay": 500 // 点击后延迟0.5s
	},

	// 结束：成功进入游戏，终止任务
	"Start_End": {
		"focus": "> 《银与血》启动成功",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
