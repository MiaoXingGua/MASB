{
	// 入口：启动《银与血》，空操作跳转StartApp
	"启动游戏_开始": {
		"focus": "> 启动【银与血】",
		"max_hit": 1,
		"next": ["Start_App", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	},

	// 启动APP，定义正常流程和异常处理
	"Start_App": {
		"focus": "> 正在启动《银与血》...",
		"action": {"type": "StartApp", "param": {"package": "com.moonton.silverblood.ap"}},
		"next": [
			"Start_ClickStart",
			"Start_AlreadyInHomePage",
			"UpdatingMaintenance",
			"[JumpBack]CheckRetry",
			"[JumpBack]InitFalse",
			"[JumpBack]CheckRelogin",
			"[JumpBack]CheckDownload",
			"[JumpBack]CheckStartDownload",
			"[JumpBack]CheckDownloadFinish",
			"[JumpBack]CheckConfirm",
			"[JumpBack]Login_CheckLoginButton",
			"[JumpBack]CheckProtocol",
			"[JumpBack]CheckCloseAnnouncement",
			"[JumpBack]TapAnywhere",
			"[JumpBack]TapBlankWhere",
			"[JumpBack]CheckReturn",
			"[JumpBack]Return_Home"
			// "[JumpBack]TapTap"
		],
		"post_delay": 5000, // 启动后延迟5s
		"rate_limit": 5000, // 每5s检查
		"timeout": 3600000 // 总超时60min
	},

	// 检查是否已在首页，成功则结束
	"Start_AlreadyInHomePage": {
		"focus": "> 检查是否在首页...",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": ["blood_pool.png", "blood_pool_empty.png"], "threshold": 0.7, "roi": [0, 0, 0, 0]}
		}, // 0.5 不够
		"next": ["Start_End", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"timeout": 10000, // 10s超时，快速检查
		"rate_limit": 2000 // 每2s检查
	},

	// 检查START按钮，成功则点击并检查公告
	"Start_ClickStart": {
		"focus": "> 等待START按钮...",
		"recognition": {"type": "OCR", "param": {"expected": "START", "roi": [532, 524, 195, 117]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Start_AlreadyInHomePage",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin",
			"[JumpBack]InitFalse",
			"[JumpBack]CheckDownload",
			"[JumpBack]CheckStartDownload",
			"[JumpBack]CheckDownloadFinish",
			"[JumpBack]CheckConfirm",
			"[JumpBack]Login_CheckLoginButton",
			"[JumpBack]CheckProtocol",
			"[JumpBack]TapAnywhere",
			"[JumpBack]TapBlankWhere",
			"[JumpBack]CheckReturn",
			"[JumpBack]CheckCloseAnnouncement"
		],
		"pre_delay": 500, // 识别后延迟0.5s
		"post_delay": 1000, // 点击后延迟1s
		"rate_limit": 3000, // 每3s检查
		"timeout": 600000 // 总超时10min
	},

	// 检查公告“X”按钮，15秒内检测到则点击，未检测到结束
	"CheckCloseAnnouncement": {
		"next": ["[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "_CheckCloseAnnouncement"],
		"focus": "> 检查公告关闭（X）...",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": ["close_button.png", "ad_close_red.png", "ad_close.png"], "threshold": 0.7, "roi": [1095, 45, 110, 120]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"timeout": 15000, // 15s超时
		"rate_limit": 1000, // 每1s检查
		"post_delay": 500 // 点击后延迟0.5s
	},
	"_CheckCloseAnnouncement": {},

	// 结束：成功进入游戏，终止任务
	"Start_End": {
		"focus": "> 《银与血》启动成功",
		"next": ["Return_Home", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	}
}
