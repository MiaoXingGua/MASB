{
	// 三队BO3
	"忘却中庭_斗技场_死斗赛_开始": {
		"focus": "> 开始 【死斗赛】",
		"max_hit": 1,
		"next": ["Courtyard_Arena_Deathmatch_EnterYard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "[JumpBack]CloseAd"]
	},

	"Courtyard_Arena_Deathmatch_EnterYard": {
		"focus": "> 进入【忘却中庭】",
		"recognition": {"type": "OCR", "param": {"expected": "忘却中庭", "roi": [1145, 370, 105, 45]}}, // [1157, 382, 83, 25]
		"action": {"type": "Click", "param": {"target": true, "target_offset": [0, -50, 0, 0]}},
		"next": ["Courtyard_Arena_Deathmatch_ClickBloodArena", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Courtyard_Arena_Deathmatch_ClickBloodArena": {
		"focus": "> 点击【鲜血斗技场】",
		"recognition": {"type": "OCR", "param": {"expected": "鲜血斗技场", "roi": [75, 345, 130, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Courtyard_Arena_Deathmatch_ClickReward",
			"Courtyard_Arena_Deathmatch_ClickDeathMatch",
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 1000
	},

	// courtyard_arena_crucible_reward.png
	"Courtyard_Arena_Deathmatch_ClickReward": {
		"focus": "> 领取【死斗赛奖励】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {
				"template": ["courtyard_arena_crucible_reward.png", "courtyard_arena_crucible_reward_true.png"],
				"threshold": 0.8,
				"roi": [0, 0, 0, 0] // x+155 // 位置会变更（有特殊斗技场不定时开放）[1005, 140, 85, 65]
			}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Deathmatch_ClaimReward", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1200,
		"rate_limit": 2000
	},

	"Courtyard_Arena_Deathmatch_ClaimReward": {
		"focus": "> 点击【领取】",
		"recognition": {"type": "OCR", "param": {"expected": "领取", "roi": [815, 575, 80, 60]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Deathmatch_ClickAnywhere", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 600
	},

	"Courtyard_Arena_Deathmatch_ClickAnywhere": {
		"focus": "> 点击任意处继续",
		"recognition": {"type": "OCR", "param": {"expected": "点击任意处继续", "roi": [555, 635, 175, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Courtyard_Arena_Deathmatch_ClickCancel", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 600
	},

	"Courtyard_Arena_Deathmatch_ClickCancel": {
		"focus": "> 点击【取消】",
