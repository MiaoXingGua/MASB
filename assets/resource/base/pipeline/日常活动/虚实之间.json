{
	"虚实之间_开始": {
		"focus": "> 开始 【虚实之间】",
		"max_hit": 1,
		"next": ["Xushi_EnterCourtyard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin", "[JumpBack]CloseAd"]
	},

	// 识别《忘却中庭》点击进入
	"Xushi_EnterCourtyard": {
		"focus": "> 进入【忘却中庭】",
		"recognition": {"type": "OCR", "param": {"expected": "忘却中庭", "roi": [1145, 370, 105, 45]}}, // [1157, 382, 83, 25]
		"action": {"type": "Click", "param": {"target": true, "target_offset": [0, -50, 0, 0]}},
		"next": ["Xushi_EnterXushi", "Xushi_EnterCourtyard", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	// 识别《虚实之间》点击进入
	"Xushi_EnterXushi": {
		"focus": "> 进入【虚实之间】",
		"recognition": {"type": "OCR", "param": {"expected": "虚实之间", "roi": [620, 225, 110, 45]}}, // [630, 235, 88, 24],
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Xushi_MainInterfaceLoop", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 800
	},

	"Xushi_MainInterfaceLoop": {
		"focus": "> 主界面",
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Xushi_CheckChallengeTimes", // 主界面 匹配今天能打的图
			"Xushi_End", // 没有能打的结束
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800
	},

	// 识别剩余挑战次数（正则匹配 3/3、2/3、1/3）并点击
	"Xushi_CheckChallengeTimes": {
		"focus": "> 检查剩余挑战次数",
		"recognition": {"type": "OCR", "param": {"expected": "[1-3]/3", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Xushi_Level04", // 从高层开始匹配
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 500
	},

	// 第04层 [55, 360, 105, 60] ← [65, 371, 85, 40]
	// 第03层 [55, 280, 105, 60] ← [65, 289, 85, 40]
	// 第02层 [55, 195, 105, 60] ← [65, 205, 85, 40]
	// 第01层 [55, 105, 105, 60] ← [65, 117, 85, 40]

	// 识别《第04层》点击
	"Xushi_Level04": {
		"focus": "> 选择【第04层】",
		"recognition": {"type": "OCR", "param": {"expected": "第04层", "roi": [55, 360, 105, 60]}}, // [68, 371, 86, 40]
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Xushi_QuickKill_04", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 500
	},

	// 快速斩杀
