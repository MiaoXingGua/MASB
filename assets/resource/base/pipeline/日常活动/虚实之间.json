		"recognition": {"type": "OCR", "param": {"expected": "第02层", "roi": [55, 195, 105, 60]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Xushi_QuickKill_02", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 500
	},

	// 快速斩杀
