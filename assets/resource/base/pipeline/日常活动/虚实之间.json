	// 识别《开始扫荡》点击
	"Xushi_StartSweep": {
		"focus": "> 点击【开始扫荡】",
		"recognition": {"type": "OCR", "param": {"expected": "开始扫荡", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Xushi_CloseButton", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 1000
	},

	// 识别图像《close_button.png》点击关闭
	"Xushi_CloseButton": {
		"focus": "> 关闭弹窗",
		"recognition": {"type": "TemplateMatch", "param": {"template": "close_button.png", "threshold": 0.8, "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Xushi_Return", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"],
		"post_delay": 500
	},

	// 识别《返回》点击
	"Xushi_Return": {
		"focus": "> 点击【返回】",
		"recognition": {"type": "OCR", "param": {"expected": "返回", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": [
			"Xushi_MainInterfaceLoop", // 继续识别 看看还有没有能打的
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 800
	},

	// 虚实之间流程结束
	"Xushi_End": {
		"focus": "> 【虚实之间】 结束",
		"next": ["Return_Home", "[JumpBack]CheckRetry", "[JumpBack]CheckRelogin"]
	}
