		"next": [
			"Xushi_StartSweep", // 出现扫荡
			"Xushi_Return", // 没出现扫荡 直接返回（第一层都没有 快速斩杀 就不打了）
			"[JumpBack]CheckRetry",
			"[JumpBack]CheckRelogin"
		],
		"post_delay": 500
