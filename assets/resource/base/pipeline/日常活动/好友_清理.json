{
	"好友_清理_开始": {
		"focus": "> 开始 【清理好友】",
		"next": ["Friend_Delete_Enter"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	"Friend_Delete_Enter": {
		"focus": "> > 进入【好友界面】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": ["friend_main.png", "friend_main_new.png"], "threshold": 0.8, "roi": [0, 0, 0, 0]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Delete_SortAscending", "Friend_Delete_SortDescending"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1500
	},

	"Friend_Delete_SortAscending": {
		"focus": "> 好友是顺序排列的",
		"recognition": {"type": "TemplateMatch", "param": {"template": "friend_sort_ascending.png", "threshold": 0.8, "roi": [275, 640, 70, 50]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Delete_Start"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Friend_Delete_SortDescending": {
		"focus": "> 好友是逆序排列的",
		"recognition": {"type": "TemplateMatch", "param": {"template": "friend_sort_descending.png", "threshold": 0.8, "roi": [275, 640, 70, 50]}},
		"next": ["Friend_Delete_Start"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 2 识别文字《天前》
	"Friend_Delete_Start": {
		"focus": "> 开始清理",
		"next": ["Friend_Delete_CheckFindDaysAgo", "Friend_Delete_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	"Friend_Delete_CheckFindDaysAgo": {
		"focus": "> 找到3天不上线的好友",
		"recognition": {"type": "OCR", "param": {"expected": "^([4-9]|[1-9]\\d+)天前$", "roi": [495, 175, 150, 55]}},
		"next": ["Friend_Delete_ClickMenu"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	// 3 点击图片《friend_menu.png》
	"Friend_Delete_ClickMenu": {
		"focus": "> 点击【菜单】",
		"recognition": {"type": "TemplateMatch", "param": {"template": "friend_menu.png", "threshold": 0.8, "roi": [995, 175, 80, 80]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Delete_ClickDelete"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 4 点击文字《删除》
	"Friend_Delete_ClickDelete": {
		"focus": "> 点击【删除】",
		"recognition": {"type": "OCR", "param": {"expected": "删除", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Delete_Confirm"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 5 点击文字《确认》
	"Friend_Delete_Confirm": {
		"focus": "> 再点一次【确认】",
		"recognition": {"type": "OCR", "param": {"expected": "确认", "roi": [0, 0, 0, 0]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Friend_Delete_Start"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	// 结束
	"Friend_Delete_End": {
		"focus": "> 【清理好友】 结束",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
