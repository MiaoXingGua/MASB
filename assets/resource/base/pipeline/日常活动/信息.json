{
	"信息_开始": {
		"focus": "> 开始 【查看信息】",
		"next": ["Message_ClickMessageEntry", "Message_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	},

	"Message_ClickMessageEntry": {
		"focus": "> 进入 【信息】",
		"recognition": {
			"type": "TemplateMatch",
			"param": {"template": ["message.png", "message_new.png"], "roi": [385, 15, 65, 40]}
		},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Message_OneKeyClaim"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 1000
	},

	"Message_OneKeyClaim": {
		"focus": "> 点击【一键领取】",
		"recognition": {"type": "OCR", "param": {"expected": "键领取", "roi": [300, 575, 75, 35]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Message_ClickAnywhere", "Message_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 800
	},

	"Message_ClickAnywhere": {
		"focus": "> 【点击任意处继续】",
		"recognition": {"type": "OCR", "param": {"expected": "点击任意处继续", "roi": [555, 635, 165, 45]}},
		"action": {"type": "Click", "param": {"target": true}},
		"next": ["Message_End"],
		"interrupt": ["CheckRetry", "CheckRelogin"],
		"post_delay": 600
	},

	"Message_End": {
		"focus": "> 【查看信息】 结束",
		"next": ["Return_Home"],
		"interrupt": ["CheckRetry", "CheckRelogin"]
	}
}
