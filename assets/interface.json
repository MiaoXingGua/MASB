{
	"name": "MASB - MaaAssistantSilver&Blood 银与绯",
	"url": "https://github.com/MiaoXingGua/MASB",
	"custom_title": "",
	"mirrorchyan_rid": "MASB",
	"mirrorchyan_multiplatform": true,
	"version": "v0.0.1",
	"mfa_min_version": "v1.4.1",
	"message": "- 银 与 绯 -",
	"controller": [
		{
			"name": "安卓模拟器（Android）",
			"type": "Adb"
		}
	],
	"resource": [
		{
			"name": "国际服",
			"path": ["{PROJECT_DIR}/resource/base"]
		}
	],
	"agent": {
		"child_exec": "python",
		"child_args": ["{PROJECT_DIR}/agent/main.py"]
	},
	"task": [
		{
			"name": "启动游戏",
			"entry": "启动游戏_开始",
			"doc": "**启动游戏**：\n\n自动启动游戏并进入主界面\n\n开始界面：模拟器桌面\n\n结束界面：游戏主界面",
			"check": true
		},
		{
			"name": "接受贡礼",
			"entry": "贡礼_开始",
			"doc": "**接受贡礼**：\n\n自动领取所有可领取的贡礼\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "收取信息",
			"entry": "信息_开始",
			"doc": "**收取信息**：\n\n自动读取并收取所有新信息\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "古堡",
			"entry": "古堡_开始",
			"option": ["八方游历", "议事阁"],
			"doc": "**古堡**：\n\n- 八方游历：执行古堡八方游历相关操作\n- 议事阁：处理古堡议事阁事务\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "商店",
			"entry": "商店_开始",
			"option": ["免费商店", "献血商店"],
			"doc": "**商店**：\n\n- 免费商店：访问人偶商店的杂货铺并领取/购买免费物品\n- 献血商店：访问人偶商店的鲜血商店\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "好友",
			"entry": "好友_开始",
			"option": ["一键收赠", "清理好友", "申请好友"],
			"doc": "**好友**：\n\n- 一键收赠：收取好友赠送并赠送好友\n- 清理好友：清理不活跃好友\n- 申请好友：通过好友申请并主动申请新好友\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "忘却中庭",
			"entry": "忘却中庭_开始",
			"option": ["英灵剑冢", "时计塔楼", "通天深渊", "斗技场_竞演赛", "斗技场_死斗赛"],
			"doc": "**忘却中庭**：\n\n- 英灵剑冢：挑战英灵剑冢\n- 时计塔楼：探索时计塔楼\n- 通天深渊：挑战通天深渊\n- 斗技场_竞演赛：参与斗技场竞演赛\n- 斗技场_死斗赛：参与斗技场死斗赛\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "氏族",
			"entry": "氏族_开始",
			"doc": "**氏族**：\n\n处理氏族相关事务（如领取氏族奖励、参与氏族活动等）\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		},
		{
			"name": "任务",
			"entry": "任务_开始",
			"doc": "**任务**：\n\n领取任务奖励并完成可自动完成的任务\n\n开始界面：主界面\n\n结束界面：主界面",
			"check": true
		}
	],
	"option": {
		"八方游历": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"古堡_开始": {
							"next": "古堡_八方游历_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"议事阁": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"古堡_开始": {
							"next": "古堡_议事阁_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"免费商店": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"商店_开始": {
							"next": "人偶商店_杂货铺_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"献血商店": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"商店_开始": {
							"next": "人偶商店_鲜血商店_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"一键收赠": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"好友_开始": {
							"next": "好友_收礼_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"清理好友": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"好友_开始": {
							"next": "好友_清理_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"申请好友": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"好友_开始": {
							"next": "好友_通过_开始"
						},
						"好友_通过_开始": {
							"next": "好友_申请_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"英灵剑冢": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"忘却中庭_开始": {
							"next": "忘却中庭_英灵剑冢_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"时计塔楼": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"忘却中庭_开始": {
							"next": "忘却中庭_时计塔楼_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"通天深渊": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"忘却中庭_开始": {
							"next": "忘却中庭_通天深渊_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"斗技场_竞演赛": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"忘却中庭_开始": {
							"next": "忘却中庭_斗技场_竞演赛_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		},
		"斗技场_死斗赛": {
			"cases": [
				{
					"name": "启用",
					"pipeline_override": {
						"忘却中庭_开始": {
							"next": "忘却中庭_斗技场_死斗赛_开始"
						}
					}
				},
				{
					"name": "禁用",
					"pipeline_override": {}
				}
			]
		}
	}
}
