{
    "tabWidth": 4,
    "printWidth": 140,
    "useTabs": false,
    "bracketSameLine": true,
    "bracketSpacing": false,
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-multiline-arrays"],
    "multilineArraysWrapThreshold": 1,
    "overrides": [
        {
            "files": [
                "**/*.yml",
                "**/*.yaml"
            ],
            "options": {
                "parser": "yaml",
                "tabWidth": 2
            }
        },
        {
            "files": [
                "**/*.json",
                "**/*.jsonc"
            ],
            "options": {
                "parser": "jsonc",
                "useTabs": true,
                "tabWidth": 4,
                "bracketSameLine": false,
                "trailingComma": "none"
            }
        }
    ]
}
